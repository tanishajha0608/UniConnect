# MongoDB Atlas connection string (Free or Flex cluster to start)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/uniconnect

# Public URL of the app, used in sign-in and notification emails
APP_URL=http://localhost:3000

# Resend API key for sign-in emails. Leave empty locally: links print to the terminal
# and show on the sign-in page instead.
RESEND_API_KEY=
# Sender address. Resend's test sender (the default) only delivers to the email on your
# Resend account. To email other students, verify your own domain at resend.com/domains
# and use an address on it, e.g. "UniConnect <login@yourdomain.com>".
EMAIL_FROM="UniConnect <onboarding@resend.dev>"

# Comma-separated emails that can open /admin to review reports
ADMIN_EMAILS=you@ucr.edu

# Only this email domain can sign up
ALLOWED_EMAIL_DOMAIN=ucr.edu
